---
import { formatDate, type Edition } from '../lib/editions';
import LinkedText from './LinkedText.astro';
import WeatherForecast from './WeatherForecast.astro';
const { edition } = Astro.props as { edition: Edition };
---
<div class="dateline"><span>VANCOUVER, BRITISH COLUMBIA</span><span>{formatDate(edition.date)}</span></div>
<section class="hero">
  <span class="eyebrow">Your personal morning paper · Edition {edition.date}</span>
  <h1>Know more.<br/>Scroll less.</h1>
  <p><LinkedText text={edition.intro}/></p>
  <span class="pill">A five-minute read</span>
</section>
{edition.status === 'sample' && <aside class="notice"><strong>Preview edition.</strong> This issue contains sample editorial content, not verified live news, event announcements, weather, or market quotes.</aside>}
<div class="section-head"><h2>The front page</h2><span>01 / The headlines</span></div>
<section class="story-grid">
  {edition.stories.map(story=><article class="story"><span class="eyebrow">{story.section}</span><h3>{story.url?<a class="link" href={story.url} target="_blank" rel="noopener noreferrer">{story.title} ↗</a>:story.title}</h3><p><LinkedText text={story.summary}/></p>{story.tag&&<span class="pill">{story.tag}</span>}</article>)}
</section>
<div class="section-head"><h2>Weather & markets</h2><span>02 / At a glance</span></div>
<div class="feature-grid">
  <WeatherForecast weather={edition.weather} date={edition.date}/>
  <section><h3 class="market-heading">The market tape</h3>{(edition.markets??[]).map(m=><div class="market-row"><strong>{m.name}</strong><div class="market-figure"><span class="market-value">{m.value}</span>{m.change&&<span class="market-change"><LinkedText text={m.change}/></span>}</div></div>)}</section>
</div>
{(edition.events?.length??0)>0&&<>
<div class="section-head"><h2>Plan your city</h2><span>03 / Vancouver radar</span></div>
<section>{(edition.events??[]).map(event=><article class="event"><small>{event.date}</small><strong>{event.url?<a class="link" href={event.url} target="_blank" rel="noopener noreferrer">{event.title} ↗</a>:event.title}</strong><p><LinkedText text={event.description}/></p></article>)}</section>
</>}

{(edition.meetups?.length??0)>0&&<><div class="section-head"><h2>Meetups & conferences</h2><span>04 / Worth attending</span></div><section class="feature-grid"><div>{(edition.meetups??[]).filter((_,i)=>i%2===0).map(e=><article class="event"><small>{e.date}</small><strong><a class="link" href={e.url} target="_blank" rel="noopener noreferrer">{e.title} ↗</a></strong><p><LinkedText text={e.description}/></p></article>)}</div><div>{(edition.meetups??[]).filter((_,i)=>i%2===1).map(e=><article class="event"><small>{e.date}</small><strong><a class="link" href={e.url} target="_blank" rel="noopener noreferrer">{e.title} ↗</a></strong><p><LinkedText text={e.description}/></p></article>)}</div></section></>}

{(edition.dining?.length??0)>0&&<><div class="section-head"><h2>Dining & drinks</h2><span>05 / The good tables</span></div><section class="feature-grid"><div>{(edition.dining??[]).filter((_,i)=>i%2===0).map(e=><article class="event"><small>{e.date}</small><strong><a class="link" href={e.url} target="_blank" rel="noopener noreferrer">{e.title} ↗</a></strong><p><LinkedText text={e.description}/></p></article>)}</div><div>{(edition.dining??[]).filter((_,i)=>i%2===1).map(e=><article class="event"><small>{e.date}</small><strong><a class="link" href={e.url} target="_blank" rel="noopener noreferrer">{e.title} ↗</a></strong><p><LinkedText text={e.description}/></p></article>)}</div></section></>}
