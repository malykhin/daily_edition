---
import Base from '../../layouts/Base.astro';
import { latest } from '../../lib/editions';
---
<Base title="Vancouver Events — The Daily Edition"><div class="hero"><span class="eyebrow">Your calendar radar</span><h1>What's next.</h1><p>Events worth planning around, surfaced ahead of time.</p></div>{latest.status==='sample'&&<aside class="notice">These are illustrative event categories, not actual event announcements.</aside>}<div class="feature-grid"><section>{(latest.events??[]).map(e=><article class="event"><small>{e.date}</small><h3>{e.url?<a class="link" href={e.url}>{e.title} ↗</a>:e.title}</h3><p>{e.description}</p></article>)}</section><section class="panel"><span class="eyebrow">Coming soon</span><h3>Don't miss the announcement.</h3><p class="summary">New events and on-sale notices can be included as soon as the research and publication workflow is connected.</p></section></div></Base>
